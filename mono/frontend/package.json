{
  "name": "stockify-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "select:shop": "node ./scripts/select-shop.mjs",
    "dev": "node ./scripts/select-shop.mjs --shop=default --env=dev && vite",
