<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ data.title|default('Document') }} — {{ profile.shop_name }}</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 12px;
            color: #111;
            margin: 0;
            padding: {{ page.margin_mm|default(10) }}mm;
        }
        @page { size: {{ page.css_page_size|default('210mm 297mm') }}; margin: 0; }
        .doc-header { text-align: center; margin-bottom: 16px; border-bottom: 1px solid #ddd; padding-bottom: 12px; }
        .doc-header img { max-height: 48px; margin-bottom: 8px; }
        .doc-title { font-size: 16px; font-weight: 700; margin: 8px 0 4px; }
        .doc-meta { color: #555; font-size: 11px; }
        .doc-table { width: 100%; border-collapse: collapse; margin: 12px 0; }
        .doc-table th, .doc-table td { border: 1px solid #ccc; padding: 6px 8px; text-align: left; }
        .doc-table th { background: #f5f5f5; }
        .doc-total { text-align: right; font-weight: 700; font-size: 14px; margin-top: 8px; }
        .doc-footer { margin-top: 24px; text-align: center; font-size: 10px; color: #666; border-top: 1px solid #eee; padding-top: 8px; }
        .cancelled { color: #c0392b; font-weight: 700; text-transform: uppercase; }
        .receipt-80mm body, body.receipt-80mm { width: 72mm; font-size: 10px; padding: 4mm; }
        .text-right { text-align: right; }
        @media print {
            .no-print { display: none !important; }
        }
    </style>
    {% block extra_styles %}{% endblock %}
</head>
<body class="{{ page.format|default('a4') == 'receipt_80mm' ? 'receipt-80mm' : '' }}">
    {% include 'impression/_header.html.twig' %}

    {% block content %}{% endblock %}

    {% if profile.footer_text %}
        <div class="doc-footer">{{ profile.footer_text }}</div>
    {% endif %}

    {% if auto_print %}
        <script>window.onload = function () { window.print(); };</script>
    {% endif %}
</body>
</html>
