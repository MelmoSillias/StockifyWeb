<div class="doc-header">
    {% if profile.show_logo and profile.logo_url %}
        <img src="{{ profile.logo_url }}" alt="{{ profile.shop_name }}">
    {% endif %}
    <div style="font-weight:700;font-size:14px;">{{ profile.shop_name }}</div>
    {% for line in profile.address_lines %}
        <div class="doc-meta">{{ line }}</div>
    {% endfor %}
    {% for phone in profile.phones %}
        <div class="doc-meta">{{ phone }}</div>
    {% endfor %}
    {% if profile.email %}
        <div class="doc-meta">{{ profile.email }}</div>
    {% endif %}
</div>
