{% extends 'impression/_layout.html.twig' %}

{% block content %}
    <div class="doc-title">{{ data.title }}</div>
    <div class="doc-meta">Réf. : {{ data.document_number }} · {{ data.issued_at }}</div>
    <div class="doc-meta">Client : {{ data.buyer_name }}</div>
    {% if data.facture_numero %}
        <div class="doc-meta">Facture : {{ data.facture_numero }}</div>
    {% endif %}

    <table class="doc-table">
        <thead><tr><th>Article</th><th class="text-right">Qté</th><th class="text-right">P.U.</th><th class="text-right">Total</th></tr></thead>
        <tbody>
            {% for line in data.lines %}
                <tr>
                    <td>{{ line.label }}</td>
                    <td class="text-right">{{ line.quantity }}</td>
                    <td class="text-right">{{ line.unit_price }}</td>
                    <td class="text-right">{{ line.line_total }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="doc-total">Total : {{ data.total_amount }}</div>
    <div class="doc-meta">Payé : {{ data.paid_amount }} · Solde : {{ data.balance }} ({{ data.payment_status }})</div>

    {% if data.paiements|length > 0 %}
        <table class="doc-table" style="margin-top:12px;">
            <thead><tr><th>Paiement</th><th>Date</th><th class="text-right">Montant</th></tr></thead>
            <tbody>
                {% for p in data.paiements %}
                    <tr><td>{{ p.reference }}</td><td>{{ p.paid_at }}</td><td class="text-right">{{ p.amount }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if data.is_cancelled %}
        <p class="cancelled">Vente annulée</p>
    {% endif %}
{% endblock %}
