{% extends 'impression/_layout.html.twig' %}

{% block content %}
    <div class="doc-title-band">
        <div>
            <p class="doc-title">{{ data.title }}</p>
        </div>
        <div>
            <span class="doc-number-badge">N° {{ data.document_number }}</span>
            <div class="doc-date">{{ data.issued_at }}</div>
        </div>
    </div>

    <div class="info-card">
        <div class="doc-meta"><strong>Acheteur :</strong> {{ data.buyer_name }}</div>
        {% if data.source_reference %}
            <div class="doc-meta">Source : {{ data.source_reference }}</div>
        {% endif %}
        {% if data.is_creance %}
            <div class="doc-meta">
                <span class="badge {{ data.credit_closed_at ? 'badge--ok' : 'badge--warn' }}">
                    {{ data.credit_closed_at ? 'Créance soldée' : 'Créance en cours' }}
                </span>
                {% if data.credit_closed_at %} — soldée le {{ data.credit_closed_at }}{% endif %}
            </div>
        {% endif %}
    </div>

    <table class="doc-table">
        <thead>
            <tr>
                <th>Désignation</th>
                <th class="text-right">Qté</th>
                <th class="text-right">P.U.</th>
                <th class="text-right">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for line in data.lines %}
                <tr>
                    <td>{{ line.label }}</td>
                    <td class="text-right">{{ line.quantity }}</td>
                    <td class="text-right">{{ line.unit_price }}</td>
                    <td class="text-right">{{ line.line_total }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="empty">Aucune ligne.</td></tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Total</th>
                <th class="text-right">{{ data.total_amount }}</th>
            </tr>
        </tfoot>
    </table>

    {% if data.paiements|length > 0 %}
        <p class="section-title">Paiements reçus</p>
        <table class="doc-table">
            <thead><tr><th>Réf.</th><th>Date</th><th class="text-right">Montant</th></tr></thead>
            <tbody>
                {% for p in data.paiements %}
                    <tr><td>{{ p.reference }}</td><td>{{ p.paid_at }}</td><td class="text-right">{{ p.amount }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
