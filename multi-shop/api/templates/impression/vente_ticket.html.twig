{% extends 'impression/_layout.html.twig' %}

{% block content %}
    <div class="doc-title-band">
        <p class="doc-title">{{ data.title }}</p>
        <span class="doc-number-badge">N° {{ data.document_number }}</span>
        <div class="doc-date">{{ data.issued_at }}</div>
    </div>

    <hr>

    <table class="kv-table">
        <tbody>
            <tr>
                <td class="kv-label">Client</td>
                <td class="kv-value">{{ data.buyer_name }}</td>
            </tr>
            {% if data.facture_numero %}
                <tr>
                    <td class="kv-label">Facture</td>
                    <td class="kv-value">{{ data.facture_numero }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <hr>

    <table class="doc-table">
        <thead><tr><th>Article</th><th class="text-right">Qté</th><th class="text-right">P.U.</th><th class="text-right">Total</th></tr></thead>
        <tbody>
            {% for line in data.lines %}
                <tr>
                    <td>{{ line.label }}</td>
                    <td class="text-right">{{ line.quantity }}</td>
                    <td class="text-right">{{ line.unit_price }}</td>
                    <td class="text-right">{{ line.line_total }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="empty">Aucun article.</td></tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Total</th>
                <th class="text-right">{{ data.total_amount }}</th>
            </tr>
        </tfoot>
    </table>

    <table class="kv-table">
        <tbody>
            <tr>
                <td class="kv-label">Payé</td>
                <td class="kv-value">{{ data.paid_amount }}</td>
            </tr>
            <tr>
                <td class="kv-label">Solde</td>
                <td class="kv-value kv-strong">{{ data.balance }} ({{ data.payment_status }})</td>
            </tr>
        </tbody>
    </table>

    {% if data.paiements|length > 0 %}
        <p class="section-title">Paiements</p>
        <table class="doc-table">
            <thead><tr><th>Paiement</th><th>Date</th><th class="text-right">Montant</th></tr></thead>
            <tbody>
                {% for p in data.paiements %}
                    <tr><td>{{ p.reference }}</td><td>{{ p.paid_at }}</td><td class="text-right">{{ p.amount }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if data.is_cancelled %}
        <p class="cancelled">Vente annulée</p>
    {% endif %}
{% endblock %}
