{% extends 'impression/_layout.html.twig' %}

{% block extra_styles %}
    <style>
        body:not(.receipt-80mm) .doc-header { border-bottom-color: #c0392b; }
        body:not(.receipt-80mm) .doc-number-badge { border-color: #c0392b; color: #c0392b; }
        body:not(.receipt-80mm) .info-card { border-left-color: #c0392b; }
        body:not(.receipt-80mm) .doc-table thead th { border-bottom-color: #c0392b; }
    </style>
{% endblock %}

{% block content %}
    <div class="doc-title-band">
        <div>
            <p class="doc-title">{{ data.title }}</p>
        </div>
        <div>
            <span class="doc-number-badge">N° {{ data.document_number }}</span>
            <div class="doc-date">{{ data.issued_at }}</div>
        </div>
    </div>

    {% if data.facture_numero %}
        <div class="info-card">
            <div class="doc-meta"><strong>Facture d'origine :</strong> {{ data.facture_numero }}</div>
        </div>
    {% endif %}

    <table class="doc-table">
        <thead><tr><th>Désignation</th><th class="text-right">Qté</th><th class="text-right">P.U.</th><th class="text-right">Total</th></tr></thead>
        <tbody>
            {% for line in data.lines %}
                <tr>
                    <td>{{ line.label }}</td>
                    <td class="text-right">{{ line.quantity }}</td>
                    <td class="text-right">{{ line.unit_price }}</td>
                    <td class="text-right">{{ line.line_total }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="empty">Aucune ligne.</td></tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Total avoir</th>
                <th class="text-right">{{ data.total_amount }}</th>
            </tr>
        </tfoot>
    </table>
{% endblock %}
