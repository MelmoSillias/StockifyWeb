{% extends 'impression/_layout.html.twig' %}

{% block content %}
    <div class="doc-title-band">
        <p class="doc-title">{{ data.title }}</p>
        <div class="doc-date">{{ data.occurred_at }}</div>
    </div>

    <hr>

    <table class="kv-table">
        <tbody>
            <tr>
                <td class="kv-label">Compte</td>
                <td class="kv-value">{{ data.compte_name }}</td>
            </tr>
            <tr>
                <td class="kv-label">Type</td>
                <td class="kv-value">{{ data.type }}</td>
            </tr>
            <tr>
                <td class="kv-label">Libellé</td>
                <td class="kv-value">{{ data.label }}</td>
            </tr>
        </tbody>
    </table>

    <hr>

    <table class="kv-table">
        <tbody>
            <tr>
                <td class="kv-label">Montant</td>
                <td class="kv-value kv-strong">{{ data.amount }}</td>
            </tr>
        </tbody>
    </table>

    {% if data.description %}
        <div class="info-card">
            <div class="doc-meta">{{ data.description }}</div>
        </div>
    {% endif %}

    {% if data.is_cancelled %}
        <p class="cancelled">Transaction annulée</p>
    {% endif %}
{% endblock %}
