<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ data.title|default('Document') }} — {{ profile.shop_name }}</title>
    <style>
        * { box-sizing: border-box; }

        :root {
            --accent: #1d6fbf;
            --accent-soft: #eef3f8;
            --muted: #586574;
            --border: #cfd8e3;
            --text: #111827;
        }

        html, body { background: #fff; }

        body {
            font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: var(--text);
            line-height: 1.45;
            margin: 0;
            padding: {{ page.margin_mm|default(10) }}mm;
        }

        @page { size: {{ page.css_page_size|default('210mm 297mm') }}; margin: 0; }

        /* ---------- En-tête de marque ---------- */
        .doc-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--accent);
        }
        .doc-header img { max-height: 52px; max-width: 140px; object-fit: contain; }
        .doc-header__brand { flex: 1; min-width: 0; }
        .doc-header__name { font-weight: 700; font-size: 15px; color: var(--text); }
        .doc-header__meta { color: var(--muted); font-size: 10.5px; }

        /* ---------- Bandeau titre ---------- */
        .doc-title-band {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 10px 0 14px;
        }
        .doc-title { font-size: 17px; font-weight: 700; color: var(--text); margin: 0; }
        .doc-number-badge {
            border: 1px solid var(--accent);
            color: var(--accent);
            border-radius: 4px;
            padding: 4px 10px;
            font-weight: 700;
            font-size: 11px;
            white-space: nowrap;
        }
        .doc-date { color: var(--muted); font-size: 10.5px; text-align: right; }

        .doc-meta { color: var(--muted); font-size: 11px; margin: 2px 0; }
        .doc-meta strong { color: var(--text); }

        /* ---------- Carte d'info ---------- */
        .info-card {
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            background: #f9fbfd;
            padding: 8px 12px;
            margin: 10px 0 14px;
        }
        .info-card .doc-meta { margin: 1px 0; }

        /* ---------- Tableau ---------- */
        .doc-table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 11.5px; }
        .doc-table th, .doc-table td { border: 1px solid var(--border); padding: 6px 9px; text-align: left; vertical-align: top; }
        .doc-table thead th { background: var(--accent-soft); font-weight: 700; border-bottom: 2px solid var(--accent); }
        .doc-table tbody tr:nth-child(even) td { background: #fafbfd; }
        .doc-table tfoot th, .doc-table tfoot td { font-weight: 700; background: var(--accent-soft); }
        .doc-table .empty { text-align: center; color: var(--muted); }

        .section-title {
            font-size: 11.5px;
            font-weight: 700;
            color: var(--accent);
            margin: 14px 0 6px;
            padding-bottom: 3px;
            border-bottom: 1px solid var(--border);
        }

        .doc-total { text-align: right; font-weight: 700; font-size: 14px; margin-top: 8px; color: var(--text); }

        .badge {
            display: inline-block;
            border-radius: 3px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .badge--ok { background: #e6f4ea; color: #1e7e34; }
        .badge--warn { background: #fdf3e0; color: #b8860b; }
        .badge--danger { background: #fbe9e7; color: #c0392b; }

        .cancelled { color: #c0392b; font-weight: 700; text-transform: uppercase; margin-top: 10px; }

        .doc-footer {
            margin-top: 24px;
            text-align: center;
            font-size: 10px;
            color: var(--muted);
            padding-top: 8px;
            border-top: 1px solid var(--border);
        }

        .text-right { text-align: right; }

        /* ---------- Lignes clé / valeur ---------- */
        .kv-table { width: 100%; border-collapse: collapse; margin: 10px 0; }
        .kv-table td { padding: 4px 0; border: none; }
        .kv-table td.kv-label { color: var(--muted); width: 45%; }
        .kv-table td.kv-value { text-align: right; font-weight: 600; }
        .kv-table td.kv-value.kv-strong { font-weight: 800; font-size: 13px; color: var(--accent); }

        /* =========================================================
           Ticket thermique 80 mm
           ========================================================= */
        body.receipt-80mm {
            width: 76mm;
            font-size: 12px;
            font-weight: 600;
            color: #000;
            padding: 3mm 2mm;
            -webkit-font-smoothing: none;
        }
        body.receipt-80mm .doc-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
            border-bottom: none;
            border-top: none;
            padding-bottom: 4px;
            margin-bottom: 4px;
        }
        body.receipt-80mm .doc-header img { max-height: 40px; filter: grayscale(100%) contrast(350%); }
        body.receipt-80mm .doc-header__name { font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
        body.receipt-80mm .doc-header__meta { color: #000; font-size: 10.5px; }
        body.receipt-80mm .doc-header::after {
            content: '';
            display: block;
            width: 100%;
            border-top: 2px solid #000;
            margin-top: 6px;
        }
        body.receipt-80mm .doc-title-band {
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin: 8px 0 6px;
        }
        body.receipt-80mm .doc-title {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        body.receipt-80mm .doc-number-badge {
            border: none;
            color: #000;
            padding: 0;
            font-size: 11px;
        }
        body.receipt-80mm .doc-date { color: #000; text-align: center; font-size: 10.5px; }
        body.receipt-80mm .doc-meta { color: #000; font-size: 11px; }
        body.receipt-80mm .info-card { border: none; border-top: 1px dashed #000; border-bottom: 1px dashed #000; background: none; padding: 6px 0; margin: 8px 0; }
        body.receipt-80mm .section-title { color: #000; border-bottom: 1px solid #000; font-size: 11px; }
        body.receipt-80mm .doc-table { border: none; font-size: 11px; }
        body.receipt-80mm .doc-table th, body.receipt-80mm .doc-table td { border: none; padding: 3px 0; color: #000; }
        body.receipt-80mm .doc-table thead th { background: none; border-bottom: 2px solid #000; font-weight: 800; }
        body.receipt-80mm .doc-table tbody tr:nth-child(even) td { background: none; }
        body.receipt-80mm .doc-table tfoot th, body.receipt-80mm .doc-table tfoot td { background: none; border-top: 2px solid #000; font-weight: 800; }
        body.receipt-80mm .kv-table td.kv-value.kv-strong { color: #000; }
        body.receipt-80mm .doc-total { color: #000; font-size: 14px; border-top: 2px solid #000; padding-top: 6px; }
        body.receipt-80mm hr { border: none; border-top: 2px solid #000; margin: 6px 0; }
        body.receipt-80mm .doc-footer {
            margin-top: 10px;
            padding-top: 6px;
            border-top: 2px solid #000;
            color: #000;
            font-size: 11px;
            font-weight: 700;
        }
        body.receipt-80mm .badge { border: 1px solid #000; background: none; color: #000; }

        @media print {
            .no-print { display: none !important; }
            * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            body.receipt-80mm { page: ticket; }
            @page ticket { size: 80mm auto; margin: 0; }
        }
    </style>
    {% block extra_styles %}{% endblock %}
</head>
<body class="{{ page.format|default('a4') == 'receipt_80mm' ? 'receipt-80mm' : '' }}">
    {% include 'impression/_header.html.twig' %}

    {% block content %}{% endblock %}

    {% if profile.footer_text %}
        <div class="doc-footer">{{ profile.footer_text }}</div>
    {% endif %}

    {% if auto_print %}
        <script>window.onload = function () { window.print(); };</script>
    {% endif %}
</body>
</html>
