{% extends 'impression/_layout.html.twig' %}

{% block content %}
    <div class="doc-title-band">
        <div>
            <p class="doc-title">{{ data.title }}</p>
        </div>
        <div>
            <span class="doc-number-badge">N° {{ data.document_number }}</span>
            <div class="doc-date">{{ data.paid_at }}</div>
        </div>
    </div>

    <hr>

    <table class="kv-table">
        <tbody>
            <tr>
                <td class="kv-label">Mode de paiement</td>
                <td class="kv-value">{{ data.method_label }}</td>
            </tr>
            {% if data.context_label %}
                <tr>
                    <td class="kv-label">{{ data.context_label }}</td>
                    <td class="kv-value">{{ data.context_reference|default('—') }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <hr>

    <table class="kv-table">
        <tbody>
            <tr>
                <td class="kv-label">Montant payé</td>
                <td class="kv-value kv-strong">{{ data.amount }}</td>
            </tr>
        </tbody>
    </table>

    {% if data.is_cancelled %}
        <p class="cancelled">Paiement annulé</p>
    {% endif %}
{% endblock %}
