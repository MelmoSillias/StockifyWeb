{% extends 'impression/_layout.html.twig' %}

{% block content %}
    <div class="doc-title-band">
        <div>
            <p class="doc-title">{{ data.title }}</p>
        </div>
        <div>
            <span class="doc-number-badge">N° {{ data.document_number }}</span>
            <div class="doc-date">
                Envoyé le {{ data.sent_at }}
                {% if data.delivered_at %} · Livré le {{ data.delivered_at }}{% endif %}
            </div>
        </div>
    </div>

    <div class="info-card">
        <div class="doc-meta"><strong>Commande :</strong> {{ data.commande_reference|default('—') }}</div>
        <div class="doc-meta">
            <strong>Statut :</strong>
            <span class="badge {{ data.delivered_at ? 'badge--ok' : 'badge--warn' }}">{{ data.status }}</span>
        </div>
    </div>

    <table class="doc-table">
        <thead><tr><th>Désignation</th><th class="text-right">Quantité</th></tr></thead>
        <tbody>
            {% for line in data.lines %}
                <tr><td>{{ line.label }}</td><td class="text-right">{{ line.quantity }}</td></tr>
            {% else %}
                <tr><td colspan="2" class="empty">Aucune ligne.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
